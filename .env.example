# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# LangSmith
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=multiagent-research-system
LANGSMITH_TRACING=true

# Redis
REDIS_URL=redis://localhost:6379/0

# PostgreSQL + pgvector
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/research

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=multiagent-research-system

# Quality gate — min avg Critic score (0–1) before HITL escalation
CRITIC_PASS_THRESHOLD=0.7

# Separate Redis DB for HITL queue
HITL_QUEUE_URL=redis://localhost:6379/1

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Celery
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3
